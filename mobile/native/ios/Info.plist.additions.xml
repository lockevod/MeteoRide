<!--
  Reference snippet — merge these keys into ios/App/App/Info.plist.
  They declare the meteoride:// scheme the share extension calls, register the app
  as a handler for .gpx/.kml files, explain the location prompt, and let the ride
  watch run in the background.
-->

<key>CFBundleURLTypes</key>
<array>
	<dict>
		<key>CFBundleURLName</key>
		<string>cc.meteoride.app</string>
		<key>CFBundleTypeRole</key>
		<string>Editor</string>
		<key>CFBundleURLSchemes</key>
		<array>
			<string>meteoride</string>
		</array>
	</dict>
</array>

<!-- GPX has no system UTI, so declare one and hang the .gpx extension off it. -->
<key>UTImportedTypeDeclarations</key>
<array>
	<dict>
		<key>UTTypeIdentifier</key>
		<string>cc.meteoride.gpx</string>
		<key>UTTypeDescription</key>
		<string>GPS Exchange Format</string>
		<key>UTTypeConformsTo</key>
		<array>
			<string>public.xml</string>
		</array>
		<key>UTTypeTagSpecification</key>
		<dict>
			<key>public.filename-extension</key>
			<array>
				<string>gpx</string>
			</array>
			<key>public.mime-type</key>
			<array>
				<string>application/gpx+xml</string>
			</array>
		</dict>
	</dict>
</array>

<key>CFBundleDocumentTypes</key>
<array>
	<dict>
		<key>CFBundleTypeName</key>
		<string>Route</string>
		<key>CFBundleTypeRole</key>
		<string>Viewer</string>
		<key>LSHandlerRank</key>
		<string>Alternate</string>
		<key>LSItemContentTypes</key>
		<array>
			<string>cc.meteoride.gpx</string>
			<string>com.google.earth.kml</string>
		</array>
	</dict>
</array>

<!-- Copy opened documents into the app sandbox instead of editing them in place. -->
<key>LSSupportsOpeningDocumentsInPlace</key>
<false/>

<key>NSLocationWhenInUseUsageDescription</key>
<string>MeteoRide uses your location to centre the map on where you are.</string>

<!-- Rotating breaks the layout badly, so the app is locked to portrait. Capacitor's
     template ships all four orientations for both idioms; set both keys rather than
     leave the iPad one to fall back, since `cap add ios` targets iPhone and iPad alike
     unless that is changed by hand. -->
<key>UISupportedInterfaceOrientations</key>
<array>
	<string>UIInterfaceOrientationPortrait</string>
</array>
<key>UISupportedInterfaceOrientations~ipad</key>
<array>
	<string>UIInterfaceOrientationPortrait</string>
	<string>UIInterfaceOrientationPortraitUpsideDown</string>
	<string>UIInterfaceOrientationLandscapeLeft</string>
	<string>UIInterfaceOrientationLandscapeRight</string>
</array>

<!-- Ride alerts: the background task the runner schedules. The identifier must equal
     plugins.BackgroundRunner.label in mobile/capacitor.config.json. Xcode adds
     UIBackgroundModes itself when "Background fetch" and "Background processing" are
     ticked under Signing & Capabilities → Background Modes; listed here so a hand-edited
     plist ends up the same. -->
<key>BGTaskSchedulerPermittedIdentifiers</key>
<array>
	<string>cc.meteoride.app.watch</string>
</array>
<key>UIBackgroundModes</key>
<array>
	<string>fetch</string>
	<string>processing</string>
</array>

<!-- Location purpose strings. The app only ever asks for "when in use" — `centreOnUser`
     reads the position once, at launch, to centre the map — but Apple's upload check is
     static: it scans for *references* to the always-authorization APIs, and two installed
     plugins carry them. @capacitor/geolocation names
     NSLocationAlwaysAndWhenInUseUsageDescription in its constants, and
     @capacitor/background-runner names the older NSLocationAlwaysUsageDescription. Without
     both, the upload comes back as ITMS-90683 ("Missing purpose string"), which is a
     warning on delivery and a rejection at review.

     Declaring the strings does not make the app request always-authorization; nothing in
     this code calls for it. The wording says so, because these are shown to the user if a
     dependency ever does ask, and a string that promised something else would be a lie
     told on the app's behalf. Keep all three in step with what public/privacy-ios.html
     says about location. -->
<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
<string>MeteoRide centres the map on where you are, and only while you have the app open. It never uses your location in the background.</string>
<key>NSLocationAlwaysUsageDescription</key>
<string>MeteoRide centres the map on where you are, and only while you have the app open. It never uses your location in the background.</string>

<!-- Export compliance. MeteoRide implements no cryptography of its own and ships none:
     no algorithms, no key material, no encrypted storage. What it uses is what the
     system provides — TLS for every request, and whatever hashing or randomness the
     platform and its dependencies reach for (Capacitor calls CommonCrypto's SHA-256;
     the background runner exposes system randomness). Those are system services, not an
     implementation of this app's, which is the exemption Apple describes. The route
     fingerprints and toGeoJSON's hashes are non-cryptographic. So the answer is always
     the same one —
     and declaring it here means App Store Connect stops asking on every single upload
     instead of once. Removing this key does not change what the app does; it only puts
     the question back. If MeteoRide ever ships its own crypto, this has to go and the
     real questionnaire has to be answered.
     https://developer.apple.com/documentation/security/complying-with-encryption-export-regulations -->
<key>ITSAppUsesNonExemptEncryption</key>
<false/>
