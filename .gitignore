# Native shell (Capacitor). Generated output stays out of git; the native sources
# that have to be added by hand in Xcode live in mobile/native/ and are tracked.
mobile/www/
mobile/test-results/
mobile/playwright-report/
# The iOS project is regenerated with `cap add ios` and needs manual Xcode setup
# (docs/IOS.md). The Android one is tracked: it carries the share handling.
mobile/ios/
# The shell keeps its own manifest; the root package.json stays ignored.
!mobile/package.json
!mobile/package-lock.json

# Generated by `cap sync android`. The Android project itself is tracked, but these
# are rebuilt on every sync: the copied web bundle, the plugin list, the Cordova
# config, and the bridge module. They belong here rather than in
# mobile/android/.gitignore, because line 6 above ignores every nested .gitignore —
# so the one `cap add android` generates never reaches a clone, and on a fresh
# checkout these files show up as untracked with nothing to catch them.
mobile/android/app/src/main/assets/
mobile/android/app/src/main/res/xml/config.xml
mobile/android/capacitor-cordova-android-plugins/

# Gradle's own output, same reasoning.
mobile/android/.gradle/
mobile/android/build/
mobile/android/app/build/
mobile/android/local.properties

# Release keystore and its config: real secrets, never committed. See
# mobile/android/keystore.properties.example and docs/ANDROID.md.
*.jks
*.keystore
mobile/android/keystore.properties
