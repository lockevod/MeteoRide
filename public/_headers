/*
  # Prevent Cloudflare from injecting the analytics beacon
  Cache-Control: public, no-transform
  # A route file is attacker-controlled input and the provider API key sits in
  # localStorage, so script may only come from our own files and the pinned CDNs:
  # nothing inline, no eval. Styles allow inline because the markup and Leaflet
  # set style attributes everywhere; that grants no code execution.
  # connect-src stays open to https: because ?gpx_url= fetches a route from
  # wherever the user hosts it.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://unpkg.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://unpkg.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; font-src 'self' data: https://cdnjs.cloudflare.com; img-src 'self' data: blob: https://tile.openstreetmap.org https://unpkg.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://cdn.buymeacoffee.com; connect-src 'self' https:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=()

/shared/*.gpx
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS, DELETE
  Access-Control-Allow-Headers: Content-Type, X-File-Name, X-Follow-Redirect, X-Bypass-Service-Worker, Authorization
  Access-Control-Expose-Headers: Location, X-Shared-Exists, X-Shared-Index
  Cache-Control: no-store
  Content-Type: application/gpx+xml
  
/en/route-weather/*
  Cache-Control: public, max-age=3600

/es/tiempo-en-tu-ruta/*
  Cache-Control: public, max-age=3600

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.xml
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Content-Type: text/plain; charset=utf-8

/manifest.json
  Content-Type: application/json; charset=utf-8